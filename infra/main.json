{
  "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.47.16.16243",
      "templateHash": "18045150947019029947"
    }
  },
  "parameters": {
    "baseName": {
      "type": "string",
      "metadata": {
        "description": "Base name for resources, e.g. nicoshop."
      }
    },
    "environment": {
      "type": "string",
      "defaultValue": "dev",
      "allowedValues": [
        "dev",
        "test",
        "prod"
      ],
      "metadata": {
        "description": "Environment name."
      }
    },
    "resourceGroupName": {
      "type": "string",
      "defaultValue": "[format('rg-{0}-{1}', parameters('baseName'), parameters('environment'))]",
      "metadata": {
        "description": "Name of the resource group to create."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[deployment().location]",
      "metadata": {
        "description": "Azure region for the resource group and app resources."
      }
    },
    "skuName": {
      "type": "string",
      "defaultValue": "B1",
      "metadata": {
        "description": "App Service Plan SKU."
      }
    },
    "javaVersion": {
      "type": "string",
      "defaultValue": "17",
      "allowedValues": [
        "8",
        "11",
        "17",
        "21"
      ]
    },
    "javaContainer": {
      "type": "string",
      "defaultValue": "JAVA",
      "allowedValues": [
        "JAVA",
        "TOMCAT"
      ]
    }
  },
  "variables": {
    "suffix": "[uniqueString(subscription().subscriptionId, parameters('resourceGroupName'))]",
    "tags": {
      "app": "[parameters('baseName')]",
      "environment": "[parameters('environment')]"
    }
  },
  "resources": [
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "resourceGroup",
      "location": "[deployment().location]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "name": {
            "value": "[parameters('resourceGroupName')]"
          },
          "location": {
            "value": "[parameters('location')]"
          },
          "tags": {
            "value": "[variables('tags')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.47.16.16243",
              "templateHash": "3105841863469216183"
            }
          },
          "parameters": {
            "name": {
              "type": "string",
              "metadata": {
                "description": "Name of the resource group."
              }
            },
            "location": {
              "type": "string",
              "defaultValue": "[deployment().location]",
              "metadata": {
                "description": "Azure region for the resource group."
              }
            },
            "tags": {
              "type": "object",
              "defaultValue": {},
              "metadata": {
                "description": "Resource group tags."
              }
            }
          },
          "resources": [
            {
              "type": "Microsoft.Resources/resourceGroups",
              "apiVersion": "2024-03-01",
              "name": "[parameters('name')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]"
            }
          ],
          "outputs": {
            "id": {
              "type": "string",
              "value": "[subscriptionResourceId('Microsoft.Resources/resourceGroups', parameters('name'))]"
            },
            "name": {
              "type": "string",
              "value": "[parameters('name')]"
            }
          }
        }
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "appServicePlan",
      "resourceGroup": "[parameters('resourceGroupName')]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "name": {
            "value": "[format('asp-{0}-{1}', parameters('baseName'), parameters('environment'))]"
          },
          "location": {
            "value": "[parameters('location')]"
          },
          "skuName": {
            "value": "[parameters('skuName')]"
          },
          "tags": {
            "value": "[variables('tags')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.47.16.16243",
              "templateHash": "15360496513726469596"
            }
          },
          "parameters": {
            "name": {
              "type": "string",
              "metadata": {
                "description": "Name of the App Service Plan."
              }
            },
            "location": {
              "type": "string",
              "defaultValue": "[resourceGroup().location]",
              "metadata": {
                "description": "Azure region."
              }
            },
            "skuName": {
              "type": "string",
              "defaultValue": "P1v3",
              "metadata": {
                "description": "SKU name, e.g. B1, S1, P1v3."
              }
            },
            "capacity": {
              "type": "int",
              "defaultValue": 1,
              "minValue": 1,
              "metadata": {
                "description": "Number of instances."
              }
            },
            "tags": {
              "type": "object",
              "defaultValue": {},
              "metadata": {
                "description": "Resource tags."
              }
            }
          },
          "resources": [
            {
              "type": "Microsoft.Web/serverfarms",
              "apiVersion": "2023-12-01",
              "name": "[parameters('name')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "kind": "linux",
              "sku": {
                "name": "[parameters('skuName')]",
                "capacity": "[parameters('capacity')]"
              },
              "properties": {
                "reserved": true
              }
            }
          ],
          "outputs": {
            "id": {
              "type": "string",
              "value": "[resourceId('Microsoft.Web/serverfarms', parameters('name'))]"
            },
            "name": {
              "type": "string",
              "value": "[parameters('name')]"
            }
          }
        }
      },
      "dependsOn": [
        "[subscriptionResourceId('Microsoft.Resources/deployments', 'resourceGroup')]"
      ]
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "appService",
      "resourceGroup": "[parameters('resourceGroupName')]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "name": {
            "value": "[format('app-{0}-{1}-{2}', parameters('baseName'), parameters('environment'), variables('suffix'))]"
          },
          "location": {
            "value": "[parameters('location')]"
          },
          "appServicePlanId": {
            "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', 'appServicePlan'), '2025-04-01').outputs.id.value]"
          },
          "javaVersion": {
            "value": "[parameters('javaVersion')]"
          },
          "javaContainer": {
            "value": "[parameters('javaContainer')]"
          },
          "tags": {
            "value": "[variables('tags')]"
          },
          "appSettings": {
            "value": [
              {
                "name": "SPRING_PROFILES_ACTIVE",
                "value": "[parameters('environment')]"
              },
              {
                "name": "WEBSITES_PORT",
                "value": "8080"
              }
            ]
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.47.16.16243",
              "templateHash": "15773150498668131304"
            }
          },
          "parameters": {
            "name": {
              "type": "string",
              "metadata": {
                "description": "Globally unique name of the Web App."
              }
            },
            "location": {
              "type": "string",
              "defaultValue": "[resourceGroup().location]",
              "metadata": {
                "description": "Azure region."
              }
            },
            "appServicePlanId": {
              "type": "string",
              "metadata": {
                "description": "Resource ID of the App Service Plan."
              }
            },
            "javaVersion": {
              "type": "string",
              "defaultValue": "17",
              "allowedValues": [
                "8",
                "11",
                "17",
                "21"
              ],
              "metadata": {
                "description": "Java version."
              }
            },
            "javaContainer": {
              "type": "string",
              "defaultValue": "JAVA",
              "allowedValues": [
                "JAVA",
                "TOMCAT"
              ],
              "metadata": {
                "description": "Java web container: JAVA (embedded, e.g. Spring Boot jar) or TOMCAT (war)."
              }
            },
            "tomcatVersion": {
              "type": "string",
              "defaultValue": "10.1",
              "metadata": {
                "description": "Tomcat version (used only when javaContainer is TOMCAT)."
              }
            },
            "appSettings": {
              "type": "array",
              "defaultValue": [],
              "metadata": {
                "description": "Additional app settings."
              }
            },
            "healthCheckPath": {
              "type": "string",
              "defaultValue": "/",
              "metadata": {
                "description": "Health check path."
              }
            },
            "tags": {
              "type": "object",
              "defaultValue": {},
              "metadata": {
                "description": "Resource tags."
              }
            }
          },
          "variables": {
            "linuxFxVersion": "[if(equals(parameters('javaContainer'), 'TOMCAT'), format('TOMCAT|{0}-java{1}', parameters('tomcatVersion'), parameters('javaVersion')), format('JAVA|{0}-java{1}', parameters('javaVersion'), parameters('javaVersion')))]"
          },
          "resources": [
            {
              "type": "Microsoft.Web/sites",
              "apiVersion": "2023-12-01",
              "name": "[parameters('name')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "kind": "app,linux",
              "identity": {
                "type": "SystemAssigned"
              },
              "properties": {
                "serverFarmId": "[parameters('appServicePlanId')]",
                "httpsOnly": true,
                "siteConfig": {
                  "linuxFxVersion": "[variables('linuxFxVersion')]",
                  "alwaysOn": true,
                  "http20Enabled": true,
                  "minTlsVersion": "1.2",
                  "ftpsState": "Disabled",
                  "healthCheckPath": "[parameters('healthCheckPath')]",
                  "appSettings": "[parameters('appSettings')]"
                }
              }
            }
          ],
          "outputs": {
            "id": {
              "type": "string",
              "value": "[resourceId('Microsoft.Web/sites', parameters('name'))]"
            },
            "name": {
              "type": "string",
              "value": "[parameters('name')]"
            },
            "defaultHostName": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.Web/sites', parameters('name')), '2023-12-01').defaultHostName]"
            },
            "principalId": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.Web/sites', parameters('name')), '2023-12-01', 'full').identity.principalId]"
            }
          }
        }
      },
      "dependsOn": [
        "[extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', 'appServicePlan')]"
      ]
    }
  ],
  "outputs": {
    "resourceGroupName": {
      "type": "string",
      "value": "[reference(subscriptionResourceId('Microsoft.Resources/deployments', 'resourceGroup'), '2025-04-01').outputs.name.value]"
    },
    "webAppName": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', 'appService'), '2025-04-01').outputs.name.value]"
    },
    "webAppUrl": {
      "type": "string",
      "value": "[format('https://{0}', reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', 'appService'), '2025-04-01').outputs.defaultHostName.value)]"
    }
  }
}